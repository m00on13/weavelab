# WeaveLab Backend — Environment Variables
# Copy to .env and adjust as needed.

# Comma-separated list of allowed CORS origins (use * for dev)
CORS_ORIGINS=["*"]

# Max uploaded image size in MB
MAX_IMAGE_SIZE_MB=10

# Downscale factor for the working image (higher = faster but less detail)
DEFAULT_DOWNSCALE_FACTOR=4

# Default generation parameters
DEFAULT_NUM_NAILS=300
DEFAULT_MAX_CONNECTIONS=10000
